# Copy to .env and fill in. Never commit .env.

# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECAI_SECRET_KEY=
# Required. Generate the same way.
POSTGRES_PASSWORD=
# Required. The worker uses it to talk to OWASP ZAP. Generate the same way.
SECAI_ZAP_API_KEY=

# Public URL of the web app. Must be https:// in production (enables Secure/__Host- cookies, HSTS).
# For a quick local try-out over plain http, also set SECAI_ENV=development.
SECAI_WEB_ORIGIN=http://localhost:3000
SECAI_ENV=development

# Set to false after creating your admin account to close public sign-ups.
SECAI_ALLOW_REGISTRATION=true

# Host port for the web app.
SECAI_WEB_PORT=3000

# Scanning limits.
SECAI_SCANS_PER_DAY_PER_ORG=20
SECAI_VERIFICATION_MAX_AGE_DAYS=90
# Development only: allow scanning private/loopback addresses (refused when SECAI_ENV=production).
# SECAI_SCAN_ALLOW_PRIVATE=true

# Optional: AI analysis of findings with Claude (https://console.anthropic.com).
# Findings are redacted before they're sent; leave empty to turn AI analysis off.
SECAI_ANTHROPIC_API_KEY=
# SECAI_AI_MODEL=claude-opus-5
# SECAI_AI_EFFORT=high   # low | medium | high | xhigh | max: lower is cheaper and faster
