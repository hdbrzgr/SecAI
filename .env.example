# Copy to .env and fill in. Never commit .env.
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required ---
SECAI_SECRET_KEY=
POSTGRES_PASSWORD=
# The worker uses it to talk to OWASP ZAP.
SECAI_ZAP_API_KEY=

# --- Where SecAI is served ---
# Production: your HTTPS address, SECAI_ENV=production and SECAI_DOMAIN for Caddy.
# Local try-out: keep http://localhost:3000 and SECAI_ENV=development.
SECAI_WEB_ORIGIN=http://localhost:3000
SECAI_ENV=development
# SECAI_DOMAIN=secai.example.com
# The web container listens on this host address/port (use Caddy for public access).
# SECAI_WEB_BIND=127.0.0.1
# SECAI_WEB_PORT=3000

# --- Defaults for the admin-editable settings (used on first start only) ---
SECAI_ALLOW_REGISTRATION=true
SECAI_SCANS_PER_DAY_PER_ORG=20
SECAI_MAX_TARGETS_PER_ORG=25
SECAI_VERIFICATION_MAX_AGE_DAYS=90

# --- Optional: email (verification, password reset, scan finished) ---
# SECAI_SMTP_HOST=smtp.example.com
# SECAI_SMTP_PORT=587
# SECAI_SMTP_USERNAME=
# SECAI_SMTP_PASSWORD=
# SECAI_SMTP_FROM=SecAI <secai@example.com>
# SECAI_SMTP_SECURITY=starttls   # starttls (587) | tls (465) | none (local relay only)

# --- Optional: AI analysis of findings with Claude (https://console.anthropic.com) ---
# Findings are redacted before they're sent; leave empty to turn AI analysis off.
SECAI_ANTHROPIC_API_KEY=
# SECAI_AI_MODEL=claude-opus-5
# SECAI_AI_EFFORT=high   # low | medium | high | xhigh | max: lower is cheaper and faster

# Development only: allow scanning private/loopback addresses (refused when SECAI_ENV=production).
# SECAI_SCAN_ALLOW_PRIVATE=true
